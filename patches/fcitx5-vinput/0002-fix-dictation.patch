+}
+
+// Commit the stable part of the transcript into the client as ordinary text.
+//
+// Only clause-aligned text is handed over, and the newest kStableTailChars characters
+// are always kept back so a revision of the words currently being spoken can still be
+// applied. If the recognizer rewrites text that was already committed, we stop
+// advancing instead of corrupting what is on screen.
+void VinputEngine::advanceStableCommit(fcitx::InputContext* ic, const std::string& transcript) {
+  if (ic == nullptr || !session_.has_value()) {
+    return;
+  }
+  auto& session = *session_;
+  if (session.command_mode) {
+    return;
+  }
+
+  const size_t committed = session.committed_text.size();
+  if (transcript.size() < committed || transcript.compare(0, committed, session.committed_text) != 0) {
+    return;
+  }
+
+  const size_t boundary = StablePrefixBytes(transcript, committed);
+  if (boundary <= committed) {
+    return;
+  }
+
+  const std::string chunk = transcript.substr(committed, boundary - committed);
+  size_t chunk_chars = 0;
+  for (char byte : chunk) {
+    if ((static_cast<unsigned char>(byte) & 0xC0) != 0x80) {
+      ++chunk_chars;
+    }
+  }
+  if (chunk_chars < 2) {
+    return;
+  }
+
+  // Retract the composition region first so the client inserts the settled text at the
+  // caret, then paint the remaining tail again by the caller.
+  clearVoicePresentation(ic);
+  ic->commitString(chunk);
+  session.committed_text = transcript.substr(0, boundary);
 }
 
