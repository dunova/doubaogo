+  const std::string streamed_tail =
+      has_session ? session_->transcript_text.substr(
+                        std::min(streamed_prefix.size(), session_->transcript_text.size()))
+                  : std::string{};
   auto* ic = resolveFrontendInputContext();
 
   if (ic == nullptr) {
@@ -805,7 +945,23 @@ void VinputEngine::onRecognitionResult(fcitx::dbus::Message& msg) {
     }
   }
 
-  ic->commitString(payload.commitText);
+  // Part of the utterance may already be in the document as committed text. Only the
+  // remainder may be inserted, otherwise the speaker's own words would appear twice.
+  std::string final_text = payload.commitText;
+  if (!streamed_prefix.empty()) {
+    if (final_text.size() >= streamed_prefix.size() &&
+        final_text.compare(0, streamed_prefix.size(), streamed_prefix) == 0) {
+      final_text = final_text.substr(streamed_prefix.size());
+    } else {
