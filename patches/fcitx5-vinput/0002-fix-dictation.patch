-std::string ComposeLivePreedit(const std::string& transcript_text, const std::string& fallback_text,
-                               int max_display_width = 0) {
-  (void)max_display_width;
+// Streaming dictation is injected into the client as a composition region. Slate,
+// Lexical and ProseMirror map that region back onto their own document model and can
+// only do so while it stays inside a single text leaf: once a long dictation grows the
+// region past a leaf or paragraph boundary they throw
+// "Cannot resolve a Slate node from DOM node: [object HTMLSpanElement]" and the host
+// input box stops rendering.
+//
+// The answer is NOT to hide the speaker's own words (folding to a tail or to
+// "head...tail" is useless - the speaker can no longer read what was said). Instead
+// finished speech is handed over to the client as ordinary document text, and only the
+// few words still being revised stay in the composition region. Everything stays on
+// screen, in order, as real text; the composition region never grows, so controlled
+// editors never break. It is also what makes streaming feel instant: committed text is
+// not re-rendered on every partial result.
+constexpr size_t kStableTailChars = 8;
+// Nothing is painted into the client any more, so the only reason to hold text back is
+// that the recognizer may still revise the newest words. Once that much is waiting, hand
+// it over - a mid-sentence split is invisible to the speaker, the text simply continues.
+constexpr size_t kMaxPendingChars = 16;
+
+bool IsClauseBoundary(char32_t c) {
+  switch (c) {
+    case U'\n':
+    case U'\u3002':  // 。
+    case U'\uFF01':  // ！
+    case U'\uFF1F':  // ？
+    case U'\uFF1B':  // ；
+    case U'\uFF0C':  // ，
+    case U'\u3001':  // 、
+    case U'\uFF1A':  // ：
+    case U'.':
+    case U'!':
+    case U'?':
+    case U';':
+    case U',':
+    case U':':
+      return true;
+    default:
+      return false;
+  }
+}
+
+size_t Utf8CharLength(unsigned char lead) {
+  if ((lead & 0xE0) == 0xC0) {
+    return 2;
+  }
+  if ((lead & 0xF0) == 0xE0) {
+    return 3;
+  }
+  if ((lead & 0xF8) == 0xF0) {
+    return 4;
+  }
+  return 1;
+}
+
+// Byte offset just past the last clause boundary that still leaves at least
+// kStableTailChars characters uncommitted, so the newest words can still be revised.
+// Falls back to a fixed split inside a long unpunctuated sentence.
+size_t StablePrefixBytes(std::string_view text, size_t committed_bytes) {
+  std::vector<size_t> cp_starts;      // byte offset of every code point
+  std::vector<size_t> boundary_cps;   // code point index just past a clause boundary
+  size_t i = 0;
+  while (i < text.size()) {
+    const auto lead = static_cast<unsigned char>(text[i]);
+    const size_t len = Utf8CharLength(lead);
+    if (i + len > text.size()) {
+      break;
+    }
+    char32_t cp = lead;
+    if (len == 2) {
+      cp = static_cast<char32_t>(((lead & 0x1F) << 6) |
+                                 (static_cast<unsigned char>(text[i + 1]) & 0x3F));
+    } else if (len == 3) {
+      cp = static_cast<char32_t>(((lead & 0x0F) << 12) |
+                                 ((static_cast<unsigned char>(text[i + 1]) & 0x3F) << 6) |
+                                 (static_cast<unsigned char>(text[i + 2]) & 0x3F));
+    } else if (len == 4) {
+      cp = static_cast<char32_t>(((lead & 0x07) << 18) |
+                                 ((static_cast<unsigned char>(text[i + 1]) & 0x3F) << 12) |
+                                 ((static_cast<unsigned char>(text[i + 2]) & 0x3F) << 6) |
+                                 (static_cast<unsigned char>(text[i + 3]) & 0x3F));
+    }
+    cp_starts.push_back(i);
+    i += len;
+    if (IsClauseBoundary(cp)) {
+      boundary_cps.push_back(cp_starts.size());
+    }
+  }
+
+  const size_t total = cp_starts.size();
+  if (total <= kStableTailChars) {
+    return 0;
+  }
+
+  for (auto it = boundary_cps.rbegin(); it != boundary_cps.rend(); ++it) {
+    if (total - *it < kStableTailChars) {
+      continue;
+    }
+    const size_t start = cp_starts[*it - 1];
+    const size_t past = start + Utf8CharLength(static_cast<unsigned char>(text[start]));
+    if (past >= committed_bytes) {
+      return past;
+    }
+  }
+
+  // No usable clause boundary: still stop the composition region from growing forever.
+  size_t committed_cps = 0;
+  while (committed_cps < total && cp_starts[committed_cps] < committed_bytes) {
+    ++committed_cps;
+  }
+  if (total - committed_cps > kMaxPendingChars) {
+    const size_t cut = total - kStableTailChars;
+    if (cut > committed_cps) {
+      return cp_starts[cut];
+    }
+  }
+  return 0;
+}
+
+// Only the not-yet-committed tail goes into the composition region. Nothing is folded
+// or dropped: the rest is already real text in the document.
+std::string PendingPreeditText(const std::string& transcript_text, size_t committed_bytes,
+                               const std::string& fallback_text) {
   if (transcript_text.empty()) {
     return fallback_text;
   }
-
-  // Never fold or swallow spoken text into "head...tail" - streaming preedit flows
-  // directly into the client input box, which wraps naturally across multiple lines.
-  return transcript_text;
+  const size_t start = std::min(committed_bytes, transcript_text.size());
+  return transcript_text.substr(start);
 }
 
